<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- net9.0 is where `allows ref struct` starts (C# 13 and the .NET 9 runtime), so it is the first modern target and
		     must not be removed in the future. It matches SerializerFoundation's own tier line (NET9_0_OR_GREATER).
		     net10.0 and net11.0 exist for the BCL APIs gated by NET10_0_OR_GREATER / NET11_0_OR_GREATER; the public surface is the same as net9.0's. -->
		<TargetFrameworks>netstandard2.0;netstandard2.1;net9.0;net10.0;net11.0</TargetFrameworks>
		<LangVersion>preview</LangVersion>
		
		<!-- Unsafe Evolution is not mature yet, so we will not apply it. -->
		<!--<Features>$(Features);updated-memory-safety-rules</Features>-->
		
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<!--<AnalysisMode>Recommended</AnalysisMode>-->
		<Description>Experimental maximum-speed MessagePack serializer core, built from disassembly/branch-counter-driven optimization of the primitive layer.</Description>

		<PolySharpIncludeRuntimeSupportedAttributes>true</PolySharpIncludeRuntimeSupportedAttributes>
		<IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsAotCompatible>
		<!-- After library released, we should keep and validate api compatiblity -->
		<!--<EnablePackageValidation>true</EnablePackageValidation>-->
	</PropertyGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
		<PackageReference Include="System.Memory" Version="4.6.3" />
		<PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.0" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' or '$(TargetFramework)' == 'netstandard2.1'">
		<PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
		<PackageReference Include="System.IO.Pipelines" Version="10.0.0" />
		<PackageReference Include="System.Collections.Immutable" Version="10.0.0" />
		<PackageReference Include="System.Text.Json" Version="10.0.0" />
	</ItemGroup>
	<!-- ConvertFromJson uses JsonElement.Parse, which the in-box .NET 9 System.Text.Json does not have -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
		<PackageReference Include="System.Text.Json" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="PolySharp" Version="1.16.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<!-- The SerializerFoundation package carries its own analyzers (SF001-SF003) under analyzers/dotnet/cs.
	     PrivateAssets=none lets them flow to MessagePack consumers too; the default would keep them private to this project. -->
	<ItemGroup>
		<PackageReference Include="SerializerFoundation" Version="1.0.0" PrivateAssets="none" />
	</ItemGroup>

	<!-- Analyzer -->
	<ItemGroup>
		<ProjectReference Include="..\MessagePack.SourceGenerator\MessagePack.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
		<!-- build-order only: the code fix dll is packed below, so packing this project alone must build it first -->
		<ProjectReference Include="..\MessagePack.SourceGenerator.CodeFixes\MessagePack.SourceGenerator.CodeFixes.csproj" ReferenceOutputAssembly="false" />
	</ItemGroup>

	<!-- The package ships the source generator (with its analyzers and code fixes) under analyzers/dotnet/cs, so a
	     consumer gets generated formatters from the PackageReference alone; Unity picks the same folder up through
	     NuGetForUnity (RoslynAnalyzer label). The generator dlls are netstandard2.0 and built before this project. -->
	<ItemGroup>
		<None Include="..\MessagePack.SourceGenerator\bin\$(Configuration)\netstandard2.0\MessagePack.SourceGenerator.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
		<None Include="..\MessagePack.SourceGenerator.CodeFixes\bin\$(Configuration)\netstandard2.0\MessagePack.SourceGenerator.CodeFixes.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
	</ItemGroup>

	<!-- Global Usings -->
	<ItemGroup>
		<Using Include="SerializerFoundation" />
		<Using Include="System.Buffers" />
		<Using Include="System.Runtime.CompilerServices" />
		<Using Include="System.Runtime.InteropServices" />
	</ItemGroup>

	<!-- Internals Visible To -->
	<ItemGroup>
		<InternalsVisibleTo Include="MessagePack.Tests" Key="$(MessagePackPublicKey)" />
		<InternalsVisibleTo Include="DisassembleBenchmark" Key="$(MessagePackPublicKey)" />
	</ItemGroup>

</Project>