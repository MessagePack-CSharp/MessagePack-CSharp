<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- net11.0 uses the in-box System.IO.Compression.ZstandardEncoder/Decoder (no package dependency);
		     the other targets have no Zstandard in the BCL and bind NativeCompressions.Zstandard instead. Both wrap
		     libzstd, so the frames are interchangeable and the processor code is shared but for a small shim. -->
		<!-- netstandard2.0 like the core: NativeCompressions 1.0.1 ships that asset strong-named, which .NET Framework
		     requires of everything a strong-named assembly such as this one references. -->
		<TargetFrameworks>netstandard2.0;net9.0;net11.0</TargetFrameworks>
		<LangVersion>preview</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsAotCompatible>
		<IsPackable>true</IsPackable>
		<Description>Zstandard compression for MessagePack as a MessagePackMessageProcessor — standard Zstandard frames, composed purely through options. Uses the BCL codec on .NET 11 and NativeCompressions.Zstandard below.</Description>
	</PropertyGroup>

	<ItemGroup>
		<Using Include="System.Buffers" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' != 'net11.0'">
		<PackageReference Include="NativeCompressions.Zstandard" Version="1.1.0" />
	</ItemGroup>

	<ItemGroup>
		<!-- downlevel attributes (DoesNotReturn, scoped) for the netstandard2.0 build, as in the core -->
		<PackageReference Include="PolySharp" Version="1.16.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<!-- PrivateAssets="none": a ProjectReference packs as a dependency with exclude="Build,Analyzers" by default, which would
		     keep MessagePack's source generator from a consumer that references only this package (same as the Annotations shim). -->
		<ProjectReference Include="..\MessagePack\MessagePack.csproj" PrivateAssets="none" />
		<ProjectReference Include="..\MessagePack.SourceGenerator\MessagePack.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

</Project>
