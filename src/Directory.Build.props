<Project>

	<!-- Every shipped assembly is strong-name signed with the key v3 used (opensource.snk, PublicKeyToken b4a0369545f0a1be).
	     This is a contract on the assembly identity, not a formality. Assemblies built against v3 reference
	     "MessagePack, PublicKeyToken=b4a0369545f0a1be" and "MessagePack.Annotations, PublicKeyToken=b4a0369545f0a1be",
	     and the runtime binds only to an assembly carrying that public key. An unsigned build was verified to fail
	     with FileNotFoundException at the first custom-attribute load of a v3-built type. -->
	<PropertyGroup>
		<SignAssembly>true</SignAssembly>
		<AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)..\opensource.snk</AssemblyOriginatorKeyFile>
		<!-- The full public key, for InternalsVisibleTo. A signed assembly may only befriend signed assemblies,
		     named together with their public key, and the friend projects sign with the same file. -->
		<MessagePackPublicKey></MessagePackPublicKey>
	</PropertyGroup>

</Project>
