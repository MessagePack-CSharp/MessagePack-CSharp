<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <SignAssembly>True</SignAssembly>
    <LangVersion>13</LangVersion>
    <_MessagePackVersionForAssembly Condition="'$(Version)' != ''">$(Version)</_MessagePackVersionForAssembly>
    <_MessagePackVersionForAssembly Condition="'$(_MessagePackVersionForAssembly)' == '' and '$(VersionPrefix)' != ''">$(VersionPrefix)</_MessagePackVersionForAssembly>
    <_MessagePackVersionCore Condition="'$(_MessagePackVersionForAssembly)' != ''">$([System.String]::Copy('$(_MessagePackVersionForAssembly)').Split('-')[0].Split('+')[0])</_MessagePackVersionCore>
    <AssemblyVersion Condition="'$(AssemblyVersion)' == '' and '$(_MessagePackVersionCore)' != ''">$([System.Version]::Parse('$(_MessagePackVersionCore)').ToString(2)).0.0</AssemblyVersion>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)..\opensource.snk</AssemblyOriginatorKeyFile>
    <EnforceExtendedAnalyzerRules Condition="'$(IsAnalyzerProject)'=='true'">true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <!-- Include and reference README in nuget package, if a README is in the project directory. -->
  <PropertyGroup>
    <PackageReadmeFile Condition="Exists('README.md')">README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Condition="Exists('README.md')" Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>
  <Import Project="$([MSBuild]::GetPathOfFileAbove($(MSBuildThisFile), $(MSBuildThisFileDirectory)..))" />
</Project>
