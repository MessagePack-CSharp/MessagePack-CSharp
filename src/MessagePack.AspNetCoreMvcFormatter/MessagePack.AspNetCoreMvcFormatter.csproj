<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsAotCompatible>true</IsAotCompatible>
		<IsPackable>true</IsPackable>
		<Description>ASP.NET Core MVC input/output formatters for MessagePack (application/x-msgpack), the v4 counterpart of MessagePack.AspNetCoreMvcFormatter.</Description>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<!-- PrivateAssets="none": a ProjectReference packs as a dependency with exclude="Build,Analyzers" by default, which would
		     keep MessagePack's source generator from a consumer that references only this package (same as the Annotations shim). -->
		<ProjectReference Include="..\MessagePack\MessagePack.csproj" PrivateAssets="none" />
		<ProjectReference Include="..\MessagePack.SourceGenerator\MessagePack.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

</Project>
