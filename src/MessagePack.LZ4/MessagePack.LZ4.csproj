<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- netstandard2.1 is the floor although NativeCompressions 1.0.0 ships a netstandard2.0 asset: that asset
		     would be the one .NET Framework loads, and this assembly is strong-named while NativeCompressions is not,
		     which .NET Framework refuses at load time (a strong-named assembly may only reference strong-named ones).
		     The core starts at netstandard2.0; this package follows once NativeCompressions is strong-named. -->
		<TargetFrameworks>netstandard2.1;net9.0</TargetFrameworks>
		<LangVersion>preview</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsAotCompatible>
		<Description>LZ4 compression for MessagePack as a MessagePackMessageProcessor — v3-compatible Lz4Block (ext 99) and Lz4BlockArray (ext 98) envelopes, composed purely through options.</Description>
	</PropertyGroup>

	<!-- The netstandard2.1 asset is never loaded by .NET Framework (which stops at netstandard2.0), so the strong-name
	     mismatch against the unsigned NativeCompressions assemblies (CS8002) cannot bite there; every other runtime ignores it. -->
	<PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
		<NoWarn>$(NoWarn);CS8002</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<Using Include="System.Buffers" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="NativeCompressions.LZ4" Version="1.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\MessagePack\MessagePack.csproj" />
		<ProjectReference Include="..\MessagePack.SourceGenerator\MessagePack.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

</Project>
