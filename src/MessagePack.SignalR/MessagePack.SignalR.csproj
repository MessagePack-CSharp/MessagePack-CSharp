<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsAotCompatible>true</IsAotCompatible>
		<IsPackable>true</IsPackable>
		<Description>SignalR "messagepack" hub protocol (server and client) on MessagePack v4, wire-compatible with Microsoft.AspNetCore.SignalR.Protocols.MessagePack and the JavaScript/Java MessagePack clients.</Description>
	</PropertyGroup>

	<ItemGroup>
		<!-- the hub message model and IHubProtocol; a package rather than the shared framework so client-only
		     applications (HubConnection in a console or desktop app) can reference this too -->
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Common" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup>
		<!-- PrivateAssets="none": a ProjectReference packs as a dependency with exclude="Build,Analyzers" by default, which would
		     keep MessagePack's source generator from a consumer that references only this package (same as the Annotations shim). -->
		<ProjectReference Include="..\MessagePack\MessagePack.csproj" PrivateAssets="none" />
		<ProjectReference Include="..\MessagePack.SourceGenerator\MessagePack.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

</Project>
