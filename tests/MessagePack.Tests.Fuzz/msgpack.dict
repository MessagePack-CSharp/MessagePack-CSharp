# libFuzzer dictionary: msgpack format-marker bytes and the member-name strings the
# map-by-name paths compare against. Multi-byte structure comes from the seed corpus;
# these just keep the mutator supplied with valid tokens.

nil="\xc0"
false="\xc2"
true="\xc3"
bin8="\xc4"
bin16="\xc5"
bin32="\xc6"
ext8="\xc7"
ext16="\xc8"
ext32="\xc9"
float32="\xca"
float64="\xcb"
uint8="\xcc"
uint16="\xcd"
uint32="\xce"
uint64="\xcf"
int8="\xd0"
int16="\xd1"
int32="\xd2"
int64="\xd3"
fixext1="\xd4"
fixext2="\xd5"
fixext4="\xd6"
fixext8="\xd7"
fixext16="\xd8"
str8="\xd9"
str16="\xda"
str32="\xdb"
array16="\xdc"
array32="\xdd"
map16="\xde"
map32="\xdf"
negfixint="\xe0"
fixmap1="\x81"
fixarray1="\x91"
fixstr1="\xa1a"
timestamp32="\xd6\xff\x00\x00\x00\x00"
# huge length fields for the header-extreme paths
len_max32="\x7f\xff\xff\xff"
len_max16="\xff\xff"
# LZ4 envelope ext type codes (block / block-array)
lz4block_ext="\x63"
lz4array_ext="\x62"
# member names (fixstr-prefixed) for the map-by-name deserialize paths
name_id="\xa2Id"
name_name="\xa4Name"
name_score="\xa5Score"
name_flag="\xa4Flag"
name_color="\xa5Color"
name_when="\xa4When"
name_numbers="\xa7Numbers"
name_tags="\xa4Tags"
name_child="\xa5Child"
name_map="\xa3Map"
name_extra="\xa5Extra"
