<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <!-- xunit v3+ test projects are self-hosting executables -->
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- This project is an InternalsVisibleTo friend of the signed SerializerFoundation assembly, so it signs with the same key.
         CS8002 (a signed assembly referencing unsigned packages) is harmless on every runtime this repo targets. -->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)..\..\opensource.snk</AssemblyOriginatorKeyFile>
    <NoWarn>$(NoWarn);CS8002</NoWarn>
    <!-- the pointer-tier buffer tests pass stackalloc scratch via byte* -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <!-- the analyzer tests compile corlib-stub probe sources through Roslyn; the analyzers
         themselves keep their 4.8 floor and simply run on the newer host here -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageReference Include="xunit.v3" Version="4.0.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SerializerFoundation\SerializerFoundation.csproj" />
    <!-- ReferenceOutputAssembly=true: the analyzer unit tests instantiate the analyzer types
         directly; the project still runs as an analyzer on this project via OutputItemType -->
    <ProjectReference Include="..\..\src\SerializerFoundation.Analyzers\SerializerFoundation.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="true" />
  </ItemGroup>

</Project>
