<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- a net8.0 consumer resolves the netstandard2.1 core (the fast tier starts at
         net9.0), so this is the modern-runtime TFM where the generator's NET9_0_OR_GREATER
         gates must NOT fire: the emitted code has to compile against the compat surface
         (no allows-ref-struct constraints, no generic CreateFormatter override) and run
         through the Type-based dispatch. A pre-release review (2026-09-04) found this
         build broken with CS9244/CS0115; this project keeps it in the matrix. -->
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <LangVersion>13</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MessagePack\MessagePack.csproj" />
    <ProjectReference Include="..\..\src\MessagePack.SourceGenerator\MessagePack.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <!-- the C# 9 / netstandard2.1 consumer library: its generated code runs here on the netstandard2.1 core (CSharp9ConsumerTests) -->
    <ProjectReference Include="..\MessagePack.Tests.CSharp9Consumer\MessagePack.Tests.CSharp9Consumer.csproj" />
    <!-- the UnityEngine formatters as Unity loads them: a net8.0 consumer takes the netstandard2.1 asset, so the shared
         UnityShimsTests below run the netstandard bridge, the Compatible buffer pairs and the GetUnreadSpan() fast path
         (MessagePack.Tests runs the same file on the net9.0+ asset) -->
    <ProjectReference Include="..\..\src\MessagePack.UnityShims\MessagePack.UnityShims.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\MessagePack.Tests\UnityShimsTests.cs" Link="UnityShimsTests.cs" />
  </ItemGroup>

</Project>
