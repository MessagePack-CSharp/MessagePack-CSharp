<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputType>Exe</OutputType>
    <!-- net11.0 (was net10.0 through AnswerBenchmark round 9): BcsSharp ships a net11.0-only
         package. Every other dependency is a net10.0 (or older) package running forward on the
         newer runtime, so rounds measured before the switch are not ns-comparable with later
         ones; compare ratios to V4 across rounds as usual. -->
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- required so the dynamically-loaded HardwareCounters diagnoser assembly is copied to output -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- This project is an InternalsVisibleTo friend of the signed src assemblies, so it signs with the same key.
         CS8002 (a signed assembly referencing unsigned packages) is harmless on every runtime this repo targets. -->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)..\..\opensource.snk</AssemblyOriginatorKeyFile>
    <NoWarn>$(NoWarn);CS8002</NoWarn>
    <!-- MsgPack113 (container formatter without state.Enter) / MsgPack115 (header read without charging the
         declared-element budget): the hand-written formatter candidates here are dispatch-shape experiments
         whose numbers are already recorded; they leave the depth and budget contracts out on purpose and
         must not be retrofitted -->
    <NoWarn>$(NoWarn);MsgPack113;MsgPack115</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- 0.16.0-preview.2: the first BDN that recognizes a .NET 11 host (0.15.8 throws "GetRuntimeVersion not implemented for NotRecognized" at validation) -->
    <PackageReference Include="BenchmarkDotNet" Version="0.16.0-preview.2" />
    <PackageReference Include="BenchmarkDotNet.Diagnostics.Windows" Version="0.16.0-preview.2" />
    <PackageReference Include="Google.Protobuf" Version="3.35.1" />
    <PackageReference Include="Grpc.Tools" Version="2.83.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- v3 comparison target, behind `extern alias V3`: the real 3.1.8 runtime repacked
         as MessagePackV3.dll (tools/V3OracleRepack) so it coexists with this repo's
         MessagePack.dll; without its source generator the v3 rows measure the dynamic
         (Emit) resolvers (see MessagePack.Tests.csproj for the full rationale). -->
    <Reference Include="MessagePackV3" Aliases="V3">
      <HintPath>..\..\tools\oracle\MessagePackV3.dll</HintPath>
    </Reference>
    <PackageReference Include="MessagePack.Annotations" Version="3.1.8" Aliases="V3" />
    <!-- the oracle's runtime dependency (string interning paths); 18.x because
         ShapeShift.MsgPack's transitive floor is 18.0.2 (17.x would be a downgrade) -->
    <PackageReference Include="Microsoft.NET.StringTools" Version="18.0.2" />
    <!-- 5.6.0 is BenchmarkDotNet 0.16.0-preview.2's floor (NU1605 otherwise) -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    <!-- Orleans 10.2.2 pins Workspaces.Common 5.0.0 (= Common 5.0.0); lifted to the same 5.6.0 train so the graph is consistent (NU1608 otherwise) -->
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="5.6.0" />
    <PackageReference Include="Microsoft.Orleans.CodeGenerator" Version="10.2.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Orleans.Serialization" Version="10.2.2" />
    <!-- BuildServiceProvider for the standalone Orleans Serializer; flowed transitively through
         BenchmarkDotNet 0.15.8, no longer through 0.16 -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Nerdbank.MessagePack" Version="1.3.85" />
    <!-- PolyType-based multi-format serializer (same author as Nerdbank.MessagePack;
         alpha, net10.0-only). The MsgPack, Json and Protobuf format packages share one
         shape graph; Protobuf (new in 1068) has no field-number attribute and rides the
         default property-name contract. -->
    <PackageReference Include="ShapeShift.MsgPack" Version="0.1.1068-alpha" />
    <PackageReference Include="ShapeShift.Json" Version="0.1.1068-alpha" />
    <PackageReference Include="ShapeShift.Protobuf" Version="0.1.1068-alpha" />
    <!-- CAPCOM RE:Dox: token-DOM structured data engine (parse to a token DOM, then bind);
         its msgpack side is map-form only (property-name keys, no positional contract,
         net10.0-only), so it is measured in AnswerMapBenchmark -->
    <PackageReference Include="CAPCOM.REDox.MessagePack" Version="1.0.1" />
    <!-- Binary Canonical Serialization (the Sui/Move wire format: positional, untagged, no null,
         byte-compatible with Rust's bcs crate). Reflection + compiled expression trees, no source
         generator; net11.0-only (C# 15 `union` for Option<T>). Its row rides a pre-mapped twin
         graph (AnswerBcs.cs) because BCS has no null reference and no timestamp type. -->
    <PackageReference Include="BcsSharp" Version="0.1.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="protobuf-net" Version="3.2.56" />
    <PackageReference Include="System.Numerics.Tensors" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="answer.proto" GrpcServices="None" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MessagePack\MessagePack.csproj" />
    <ProjectReference Include="..\..\src\MessagePack.LZ4\MessagePack.LZ4.csproj" />
    <ProjectReference Include="..\..\src\MessagePack.Zstandard\MessagePack.Zstandard.csproj" />
    <ProjectReference Include="..\..\src\MessagePack.SourceGenerator\MessagePack.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <!-- IDE-only: lights up the code fixes for the analyzer diagnostics (the compiler skips it) -->
    <ProjectReference Include="..\..\src\MessagePack.SourceGenerator.CodeFixes\MessagePack.SourceGenerator.CodeFixes.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <!-- v3 SOURCE-GENERATED rows: model twins + v3's real generated resolver, compiled
         against the repacked MessagePackV3.dll (see that project's csproj comment) -->
    <ProjectReference Include="..\V3GeneratedModels\V3GeneratedModels.csproj" />
  </ItemGroup>

</Project>
