<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<!-- the whole point: this app must publish as Native AOT with ZERO IL warnings and
		     then run the verification matrix natively. It deliberately never touches the
		     [RequiresDynamicCode] surface (no options-less entries, no default chain). -->
		<PublishAot>true</PublishAot>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<InvariantGlobalization>true</InvariantGlobalization>
	</PropertyGroup>

	<ItemGroup>
		<!-- MessagePack-CSharp is referenced for the [MessagePackObject]/[Key] attributes only
		     (the source generator matches MessagePack.MessagePackObjectAttribute); nothing of
		     it is invoked at runtime, so the trimmer drops the assembly body. -->
		<PackageReference Include="MessagePack" Version="3.1.8" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\UltraMessagePack\UltraMessagePack.csproj" />
		<ProjectReference Include="..\UltraMessagePack.SourceGenerator\UltraMessagePack.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

</Project>
