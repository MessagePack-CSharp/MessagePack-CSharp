<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Since net10.0 is defined as the minimum version where `allows ref struct` can be used, it must not be removed in the future. -->
		<TargetFrameworks>netstandard2.0;netstandard2.1;net10.0</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<Description>Serializer-agnostic buffer foundation: IWriteBuffer/IReadBuffer abstractions with pooled, fixed, IBufferWriter and pipe implementations across the modern (`allows ref struct`) and downlevel tiers.</Description>
		<IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsAotCompatible>
	</PropertyGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
		<PackageReference Include="System.Memory" Version="4.6.3" />
		<PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.0" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' or '$(TargetFramework)' == 'netstandard2.1'">
		<PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
		<PackageReference Include="System.IO.Pipelines" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="PolySharp" Version="1.16.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<!-- Analyzer: keeps the NonCopyable protection on the buffer structs themselves -->
	<ItemGroup>
		<ProjectReference Include="..\UltraMessagePack.SourceGenerator\UltraMessagePack.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

	<!-- Global Usings -->
	<ItemGroup>
		<Using Include="System.Buffers" />
		<Using Include="System.Runtime.CompilerServices" />
		<Using Include="System.Runtime.InteropServices" />
	</ItemGroup>

	<!-- Internals Visible To -->
	<ItemGroup>
		<InternalsVisibleTo Include="UltraMessagePack.Tests" />
		<InternalsVisibleTo Include="DisassembleBenchmark" />
	</ItemGroup>

</Project>
