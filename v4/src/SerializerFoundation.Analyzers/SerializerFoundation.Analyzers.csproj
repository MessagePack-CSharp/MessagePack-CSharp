<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <Description>Analyzers enforcing SerializerFoundation's buffer contracts: SF001 (IWriteBuffer/IReadBuffer implementations must be structs; the ID was recycled from the retired mandatory-net10.0-target rule), SF002 (buffer structs are single-owner and must not be copied), SF003 ([RequireOverride] virtuals must be overridden wherever the member is visible). Foundation-level rules only; serializer-specific analyzers live with their own generator.</Description>
    <!-- RS2008: analyzer release tracking files are packaging ceremony, not needed in the lab -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- keep the floor low: the IDE loads analyzers with ITS OWN Roslyn, so targeting a
         new Microsoft.CodeAnalysis breaks Visual Studio versions older than that Roslyn
         while dotnet build keeps working. Pinned to match MessagePack.SourceGenerator. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
